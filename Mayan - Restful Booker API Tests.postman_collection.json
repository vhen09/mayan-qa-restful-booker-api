            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking details were updated correctly\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.firstname).to.eql(\"QA\");\r\n    pm.expect(response.lastname).to.eql(\"Assessment Updated\");\r\n    pm.expect(response.totalprice).to.eql(200);\r\n    pm.expect(response.depositpaid).to.eql(true);\r\n    pm.expect(response.bookingdates.checkout).to.eql(\"2026-12-10\");\r\n    pm.expect(response.additionalneeds).to.eql(\r\n        \"Breakfast and Airport Pickup\"\r\n    );\r\n});"
            ]
