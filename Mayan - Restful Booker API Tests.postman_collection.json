      "name": "02 - Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking ID exists and is a number\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.bookingid).to.be.a(\"number\");\r\n    pm.expect(response.bookingid).to.be.above(0);\r\n\r\n    pm.collectionVariables.set(\r\n        \"bookingId\",\r\n        response.bookingid.toString()\r\n    );\r\n});\r\n\r\npm.test(\"Booking details match the request\", function () {\r\n    const response = pm.response.json();\r\n    const booking = response.booking;\r\n\r\n    pm.expect(booking.firstname).to.eql(\"QA\");\r\n    pm.expect(booking.lastname).to.eql(\"Assessment\");\r\n    pm.expect(booking.totalprice).to.eql(150);\r\n    pm.expect(booking.depositpaid).to.eql(true);\r\n    pm.expect(booking.bookingdates.checkin).to.eql(\"2026-12-01\");\r\n    pm.expect(booking.bookingdates.checkout).to.eql(\"2026-12-05\");\r\n    pm.expect(booking.additionalneeds).to.eql(\"Breakfast\");\r\n});"
            ]
          }
        }
      ],
